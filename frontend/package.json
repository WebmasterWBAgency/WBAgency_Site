{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/prebuild-version.js",
    "build": "ng build",
    "postbuild": "node -e \"const fs = require('fs'); if (fs.existsSync('public/.htaccess')) { fs.copyFileSync('public/.htaccess', 'dist/frontend/.htaccess'); }\"",
    "build:prod": "ng build --configuration production",
    "build:hostinger": "powershell -ExecutionPolicy Bypass -File ../scripts/prepare-hostinger-bundle.ps1",
    "deploy:hostinger": "powershell -ExecutionPolicy Bypass -File ../scripts/prepare-hostinger-bundle.ps1",
    "optimize:assets": "powershell -ExecutionPolicy Bypass -File ../scripts/optimize-assets.ps1",
    "validate": "powershell -ExecutionPolicy Bypass -File ../scripts/validate-before-deploy.ps1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:responsive": "npx playwright test playwright/responsive",
    "audit:perf:mobile": "lhci autorun --collect.settings.preset=mobile",
    "audit:perf:desktop": "lhci autorun --collect.settings.preset=desktop"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.8",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^20.0.7",
    "@angular/router": "^21.2.25",
    "lucide-angular": "^1.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.6.1",
    "jasmine-core": "~5.2.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.5.2"
  }
}
